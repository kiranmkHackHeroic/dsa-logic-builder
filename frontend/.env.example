# API Configuration
# URL of the Express.js backend server
VITE_API_URL=http://localhost:3001

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace VITE_API_URL if your backend runs on a different host/port
# 3. Never commit .env.local to git (it's in .gitignore)
#
# For the backend server configuration, see server/.env.example
