{
  "name": "dsa-logic-builder",
  "version": "1.0.0",
  "private": true,
  "description": "DSA Logic Builder - Full-Stack Monorepo",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend",
    "vercel-build": "npm run build:frontend",
    "start:backend": "npm run start --prefix backend",
    "start": "npm run start:backend",
    "test": "npm run test:run --prefix frontend",
    "setup:db": "node backend/setup-db.js",
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
